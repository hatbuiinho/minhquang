# Runtime
APP_ENV=production
API_PORT=8080
BACKEND_IMAGE=minhquang-be:local

# Backend
ADDR=:8080
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_MAX_CONNS=5
DB_MIN_CONNS=0

# Initial administrator (used only when the account does not exist)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=Ban quản trị
INITIAL_ADMIN_PASSWORD=change-this-password

# OTA self-hosting
OTA_STORAGE_DIR=storage/ota
OTA_CHANNEL=production
OTA_VERSION=
OTA_NOTES=
NATIVE_VERSION=1.0
PUBLIC_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# S3-compatible avatar storage. The bucket must allow public GET and browser PUT CORS.
MINIO_ENDPOINT=minio.example.com
MINIO_ACCESS_KEY=access-key
MINIO_SECRET_KEY=secret-key
MINIO_BUCKET=minhquang
MINIO_REGION=us-east-1
MINIO_USE_SSL=true
MINIO_PUBLIC_BASE_URL=https://minio.example.com/minhquang

# Android release signing
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# DeployGate
DEPLOYGATE_API_TOKEN=
DEPLOYGATE_OWNER_NAME=
DEPLOYGATE_DISTRIBUTION_KEY=
DEPLOYGATE_DISTRIBUTION_NAME=Nhân sự Minh Quang
DEPLOYGATE_MESSAGE=Android release
DEPLOYGATE_RELEASE_NOTE=
DEPLOYGATE_APK_PATH=fe/android/app/build/outputs/apk/release/app-release.apk
