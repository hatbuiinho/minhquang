# Runtime
APP_ENV=production
API_PORT=8080

# Backend
ADDR=:8080
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_MAX_CONNS=5
DB_MIN_CONNS=0

# Firebase Admin SDK
FIREBASE_PROJECT_ID=pq-reminder
FIREBASE_SERVICE_ACCOUNT_FILE=secrets/firebase-service-account.json

# Reminder worker
REMINDER_WORKER_ENABLED=true
REMINDER_WORKER_INTERVAL=30s
REMINDER_WORKER_BATCH_SIZE=25

# OTA self-hosting
OTA_STORAGE_DIR=storage/ota
OTA_CHANNEL=production
OTA_VERSION=
OTA_NOTES=
NATIVE_VERSION=1.0
PUBLIC_API_BASE_URL=https://api.example.com
VITE_API_BASE_URL=https://api.example.com

# Android release signing
ANDROID_KEYSTORE_FILE=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=

# DeployGate
DEPLOYGATE_API_TOKEN=
DEPLOYGATE_OWNER_NAME=
DEPLOYGATE_DISTRIBUTION_KEY=
DEPLOYGATE_DISTRIBUTION_NAME=Reminder Android
DEPLOYGATE_MESSAGE=Android release
DEPLOYGATE_RELEASE_NOTE=
DEPLOYGATE_APK_PATH=fe/android/app/build/outputs/apk/release/app-release.apk
